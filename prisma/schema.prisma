generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE

  @@map("visibility")
}

enum Format {
  STANDARD
  PIONEER
  MODERN
  LEGACY
  VINTAGE
  COMMANDER
  PAUPER
  OATHBREAKER
  BRAWL
  HISTORIC
  EXPLORER
  ALCHEMY
  CASUAL

  @@map("format")
}

enum CardType {
  Artifact
  Battle
  Conspiracy
  Creature
  Dungeon
  Enchantment
  Instant
  Kindred
  Land
  Phenomenon
  Plane
  Planeswalker
  Scheme
  Sorcery
  Vanguard
  Unknown
}

enum Zone {
  MAINBOARD
  SIDEBOARD
  CONSIDERING
  COMMANDER

  @@map("zone")
}

enum DeckKind {
  DECK
  WISHLIST

  @@map("deck_kind")
}

enum Rarity {
  Common
  Uncommon
  Rare
  Mythic
  Special
  Bonus

  @@map("rarity")
}

model Card {
  id            Int                      @id @default(autoincrement())
  name          String                   @unique
  nameSlug      String?                  @unique @map("name_slug")
  mainType      CardType                 @map("main_type")
  typeLine      String?                  @map("type_line")
  oracleText    String?                  @map("oracle_text")
  manaCost      String?                  @map("mana_cost")
  cmc           Float?
  colors        String[]                 @default([])
  colorIdentity String[]                 @default([]) @map("color_identity")
  keywords      String[]                 @default([])
  power         String?
  toughness     String?
  games         String[]                 @default([])
  legalities    Json                     @default("{}")
  reserved      Boolean                  @default(false)
  gameChanger   Boolean                  @default(false) @map("game_changer")
  version       String?
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  /// Generated tsvector over (name, oracle_text, type_line). Maintained by
  /// Postgres via STORED GENERATED column — see migration
  /// 20260501020000_add_card_search_tsv. Declared here so Prisma's drift
  /// detection knows about it.
  searchTsv     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((((COALESCE(name, ''::text) || ' '::text) || COALESCE(oracle_text, ''::text)) || ' '::text) || COALESCE(type_line, ''::text)))")) @map("search_tsv")
  printings     Printing[]
  deckCards     DeckCard[]
  tokens        CardToken[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "card_name_trgm_idx")
  @@index([searchTsv], type: Gin, map: "card_search_tsv_idx")
  @@map("card")
}

model CardToken {
  id              Int    @id @default(autoincrement())
  cardId          Int    @map("card_id")
  tokenName       String @map("token_name")
  tokenScryfallId String @map("token_scryfall_id")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, tokenScryfallId])
  @@index([cardId])
  @@map("card_tokens")
}

model Printing {
  id              Int        @id @default(autoincrement())
  card            Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId          Int        @map("card_id")
  scryfallId      String     @unique @map("scryfall_id")
  setCode         String     @map("set_code")
  setName         String     @map("set_name")
  collectorNumber String     @map("collector_number")
  isSerialized    Boolean    @default(false) @map("is_serialized")
  finishes        String[]   @default([])
  imageUri        String     @map("image_uri")
  backImageUri    String?    @map("back_image_uri")
  priceUsd        Decimal?   @map("price_usd") @db.Decimal(10, 2)
  priceUsdFoil    Decimal?   @map("price_usd_foil") @db.Decimal(10, 2)
  priceUsdEtched  Decimal?   @map("price_usd_etched") @db.Decimal(10, 2)
  priceEur        Decimal?   @map("price_eur") @db.Decimal(10, 2)
  priceEurFoil    Decimal?   @map("price_eur_foil") @db.Decimal(10, 2)
  priceEurEtched  Decimal?   @map("price_eur_etched") @db.Decimal(10, 2)
  rarity          Rarity?
  version         String?
  deckCards       DeckCard[]
  holdings        Holding[]

  @@index([cardId])
  @@index([setCode])
  @@index([rarity])
  @@map("printing")
}

model IngestCheckpoint {
  source    String   @id
  updatedAt String   @map("updated_at")
  ranAt     DateTime @default(now()) @updatedAt @map("ran_at")

  @@map("ingest_checkpoint")
}

model IngestLock {
  source     String   @id
  workflowId String   @map("workflow_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@map("ingest_lock")
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  emailVerified   Boolean     @default(false) @map("email_verified")
  image           String?
  name            String
  username        String      @unique
  displayUsername String?     @map("display_username")
  dateOfBirth     DateTime    @map("date_of_birth")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  decks           Deck[]
  sessions        Session[]
  accounts        Account[]
  savedDecks      SavedDeck[]
  deckLikes       DeckLike[]
  holdings        Holding[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Deck {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  name            String
  description     String?
  format          Format         @default(COMMANDER)
  visibility      Visibility     @default(PRIVATE)
  kind            DeckKind       @default(DECK)
  manualBracket   Int?           @map("manual_bracket")
  forkedFromId    String?        @map("forked_from_id")
  externalSource  String?        @map("external_source")
  externalId      String?        @map("external_id")
  externalVersion String?        @map("external_version")
  releasedAt      DateTime?      @map("released_at") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  forkedFrom      Deck?          @relation("DeckForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks           Deck[]         @relation("DeckForks")
  cards           DeckCard[]
  categories      DeckCategory[]
  revisions       DeckRevision[]
  savedBy         SavedDeck[]
  likes           DeckLike[]

  @@unique([externalSource, externalId], map: "deck_external_key")
  @@index([userId, kind])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility, updatedAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([visibility, releasedAt(sort: Desc)])
  @@map("deck")
}

model DeckCard {
  id         String    @id @default(cuid())
  deckId     String    @map("deck_id")
  cardId     Int       @map("card_id")
  quantity   Int       @default(1)
  zone       Zone      @default(MAINBOARD)
  category   String?
  printingId Int?      @map("printing_id")
  isFoil     Boolean   @default(false) @map("is_foil")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deck       Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  printing   Printing? @relation(fields: [printingId], references: [id], onDelete: SetNull)

  @@index([deckId, cardId, zone, category])
  @@index([deckId, zone])
  @@index([cardId])
  @@map("deck_card")
}

model DeckCategory {
  id        String   @id @default(cuid())
  deckId    String   @map("deck_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, name])
  @@index([deckId])
  @@map("deck_category")
}

model DeckRevision {
  id        String   @id @default(cuid())
  deckId    String   @map("deck_id")
  userId    String   @map("user_id")
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, updatedAt(sort: Desc)])
  @@map("deck_revision")
}

model SavedDeck {
  userId    String   @map("user_id")
  deckId    String   @map("deck_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([userId, deckId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([deckId])
  @@map("saved_deck")
}

model DeckLike {
  userId    String   @map("user_id")
  deckId    String   @map("deck_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([userId, deckId])
  @@index([deckId])
  @@map("deck_like")
}

enum HoldingState {
  OWNED
  WISHLIST

  @@map("holding_state")
}

model Holding {
  userId     String       @map("user_id")
  printingId Int          @map("printing_id")
  isFoil     Boolean      @default(false) @map("is_foil")
  state      HoldingState @default(OWNED)
  quantity   Int          @default(1)
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  printing Printing @relation(fields: [printingId], references: [id], onDelete: Cascade)

  @@id([userId, printingId, isFoil])
  @@index([userId, state])
  @@index([userId, printingId])
  @@index([printingId])
  @@map("holding")
}

model IngestDeckFailure {
  id          Int      @id @default(autoincrement())
  source      String
  externalId  String   @map("external_id")
  reason      String
  details     Json
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")
  resolved    Boolean  @default(false)

  @@unique([source, externalId])
  @@index([source, resolved])
  @@map("ingest_deck_failure")
}
