# Local dev only — do NOT use these credentials in any shared environment.
DATABASE_URL="postgresql://maindeck:maindeck@localhost:5432/maindeck_dev?schema=public"
CRON_SECRET="dev-only-change-me"
BETTER_AUTH_SECRET="dev-only-change-me"

# Resend credentials for email verification. In dev you can use Resend's
# onboarding sender: EMAIL_FROM="Maindeck <onboarding@resend.dev>"
RESEND_API_KEY=""
EMAIL_FROM="Maindeck <noreply@yourdomain.com>"

# Optional. Defaults to "local" off Vercel, "blob" on Vercel
# STAGING_DRIVER="local"

# Required when STAGING_DRIVER="blob" (auto on Vercel). Populated by
# `vercel env pull` after linking a Blob store, or copied from the
# Vercel dashboard (Storage > Blob > .env.local).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Required when STAGING_DRIVER="s3". Works with any S3-compatible store
# (Cloudflare R2, AWS S3, Backblaze B2, MinIO).
# S3_REGION="auto"                    # use "auto" for R2; a real region for AWS
# S3_ENDPOINT=""                      # required for R2/B2/MinIO; omit for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET=""

# Optional. Defaults to 3 on Vercel, 10 elsewhere.
# DB_POOL_MAX="10"